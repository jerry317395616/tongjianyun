  "expected_qty",
  "uom",
  "lot_number",
  "lot_source",
  "receipt_trace_no",
  "expires_on",
  "evidence_status",
  "record_weight",
  "gross_weight",
  "tare_weight",
  "net_weight",
  "accepted_qty",
  "rejected_qty",
  "batch_no",
  "reason",
  "evidence_verified"
 ],
