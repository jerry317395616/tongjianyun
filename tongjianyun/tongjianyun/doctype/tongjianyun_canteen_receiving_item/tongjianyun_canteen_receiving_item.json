   "columns": 1
  },
  {
   "fieldname": "rejected_qty",
   "label": "拒收数量（采购单位）",
   "fieldtype": "Float",
   "in_list_view": 1,
   "non_negative": 1,
   "columns": 1
  },
  {
   "fieldname": "batch_no",
   "label": "食材追溯批号",
