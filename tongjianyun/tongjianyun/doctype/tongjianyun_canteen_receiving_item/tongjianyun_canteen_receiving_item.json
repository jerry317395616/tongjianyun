   "fieldtype": "Float",
   "non_negative": 1,
   "depends_on": "eval:doc.record_weight || doc.gross_weight || doc.tare_weight"
  },
  {
   "fieldname": "net_weight",
   "label": "净重（公斤）",
   "fieldtype": "Float",
   "read_only": 1,
