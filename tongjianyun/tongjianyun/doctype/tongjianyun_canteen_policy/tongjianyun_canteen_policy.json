 "fields": [
  {
   "fieldname": "basics_tab",
   "fieldtype": "Tab Break",
   "label": "基本设置"
  },
  {
   "fieldname": "scope_section",
   "fieldtype": "Section Break",
   "label": "适用范围与经办人"
  },
  {
   "fieldname": "company",
   "label": "园所",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "canteen",
   "label": "食堂",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Tongjianyun Canteen",
   "in_list_view": 1
  },
  {
   "fieldname": "column_from_date",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "from_date",
   "label": "生效日期",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1,
   "default": "Today"
  },
  {
   "fieldname": "to_date",
   "label": "截止日期",
   "fieldtype": "Date",
   "reqd": 1
  },
  {
   "fieldname": "owner_column",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "purchase_assignee",
   "label": "采购经办人",
   "fieldtype": "Link",
   "reqd": 1,
   "options": "User",
   "description": "下发采购申请时，系统把待办发给此人。"
  },
  {
   "fieldname": "policy_name",
   "label": "规则名称",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "description": "按生效日期自动命名，可自行修改。"
  },
  {
   "fieldname": "evidence_section",
   "fieldtype": "Section Break",
   "label": "收货时核对哪些票证"
  },
  {
   "fieldname": "evidence_shortcuts",
   "fieldtype": "HTML",
   "label": "常用票证"
  },
  {
   "fieldname": "evidence_rules",
   "label": "验收票证清单",
   "fieldtype": "Table",
   "options": "Tongjianyun Canteen Evidence Rule",
   "description": "至少选一种票证。食材分类留空表示适用于所有食材，验收时逐条核对。"
  },
  {
   "fieldname": "purchasing_tab",
   "fieldtype": "Tab Break",
   "label": "采购与验收"
  },
  {
   "fieldname": "purchase_section",
   "label": "报价与下单",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "procurement_mode",
   "label": "采购方式",
   "fieldtype": "Select",
   "reqd": 1,
   "options": "校内采购\n框架协议采购\n区域集中采购",
   "default": "校内采购",
   "in_list_view": 1
  },
  {
   "fieldname": "lead_days",
   "label": "提前下单天数",
   "fieldtype": "Int",
   "non_negative": 1,
   "default": "1",
   "description": "按首个需求日期向前推算下单期限。"
  },
  {
   "fieldname": "min_quotations",
   "label": "至少比较几家报价",
   "fieldtype": "Int",
   "non_negative": 1,
   "description": "填 0 表示不设最低家数。"
  },
  {
   "fieldname": "column_min_quotations",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "price_deviation",
   "label": "历史成交偏差提醒阈值（%）",
   "fieldtype": "Float",
   "non_negative": 1,
   "default": "20"
  },
  {
   "fieldname": "contract_deviation",
   "label": "合同价最高偏差（%）",
   "fieldtype": "Float",
   "non_negative": 1,
   "default": "0"
  },
  {
   "fieldname": "safety_section",
   "label": "到货验收要求",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "require_photo",
   "label": "验收须拍照",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "require_dual_review",
   "label": "验收须双人复核",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "require_supplier_credential",
   "label": "下单及收货须核对供应商资质",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "require_location",
   "label": "验收须定位",
   "fieldtype": "Check"
  },
  {
   "fieldname": "reminder_section",
   "fieldtype": "Section Break",
   "label": "临期提醒与留样"
  },
  {
   "fieldname": "stock_warning_days",
   "label": "库存临期提前提醒（天）",
   "fieldtype": "Int",
   "non_negative": 1,
   "default": "7"
  },
  {
   "fieldname": "credential_warning_days",
   "label": "证照到期提前提醒（天）",
   "fieldtype": "Int",
   "non_negative": 1,
   "default": "30"
  },
  {
   "fieldname": "column_stock_warning_days",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "sample_required",
   "label": "应登记成品留样",
   "fieldtype": "Check",
   "default": "1",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "sample_min_weight",
   "label": "最低留样量（克）",
   "fieldtype": "Float",
   "non_negative": 1,
   "default": "125"
  },
  {
   "fieldname": "sample_keep_hours",
   "label": "最短保存时间（小时）",
   "fieldtype": "Int",
   "non_negative": 1,
   "default": "48"
  },
  {
   "fieldname": "companion_required",
   "label": "应登记陪餐",
   "fieldtype": "Check",
   "default": "1",
   "hidden": 1,
   "read_only": 1
  },
  {
   "fieldname": "finance_tab",
   "fieldtype": "Tab Break",
   "label": "财务与对账"
  },
  {
   "fieldname": "finance_section",
   "label": "对账与结算",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "settlement_cycle",
   "label": "对账周期",
   "fieldtype": "Select",
   "options": "按送货验收\n按周\n按月",
   "default": "按月"
  },
  {
   "fieldname": "finance_reviewer",
   "label": "指定财务审核人",
   "fieldtype": "Link",
   "options": "User",
   "description": "指定后，该人员负责提交财务复核。"
  },
  {
   "fieldname": "column_settlement_cycle",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "settlement_limit",
   "label": "单批结算审核限额",
   "fieldtype": "Currency",
   "description": "留空或填 0 表示不限额。"
  },
  {
   "fieldname": "cost_center",
   "label": "食堂成本中心",
   "fieldtype": "Link",
   "options": "Cost Center",
   "description": "生成会计凭证时使用。"
  },
  {
   "fieldname": "attachment_section",
   "fieldtype": "Section Break",
   "label": "报送与备注"
  },
  {
   "fieldname": "report_template",
   "label": "地方报送模板",
   "fieldtype": "Attach",
   "description": "先保存草稿，再上传私有附件。"
  },
  {
   "fieldname": "remarks",
   "label": "备注",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Canteen Policy"
  }
 ],
 "show_title_field_in_link": 1
}
