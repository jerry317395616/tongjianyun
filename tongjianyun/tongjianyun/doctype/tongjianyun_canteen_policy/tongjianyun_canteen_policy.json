   "label": "食堂成本中心",
   "fieldtype": "Link",
   "options": "Cost Center"
  },
  {
   "fieldname": "subsidy_debit_account",
   "label": "补助到账借方科目",
   "fieldtype": "Link",
   "options": "Account"
  },
  {
   "fieldname": "subsidy_credit_account",
   "label": "补助到账贷方科目",
