{
 "doctype": "DocType",
 "name": "Tongjianyun Meal Companion",
 "module": "Tongjianyun",
 "engine": "InnoDB",
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "format:MEAL-COMP-{#####}",
 "title_field": "companion",
 "track_changes": 1,
 "allow_rename": 0,
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "膳食业务经办员",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "膳食教育监管",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  },
  {
   "role": "膳食食品安全监管",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1
  }
 ],
 "is_submittable": 1,
 "field_order": [
  "company",
  "canteen",
  "meal_day",
  "meal_date",
  "meal_type",
  "companion",
  "attended_at",
  "evaluation",
  "feedback",
  "photo",
  "video",
  "attested",
  "remarks",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "company",
   "label": "园所 / 账套",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "canteen",
   "label": "食堂",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Tongjianyun Canteen"
  },
  {
   "fieldname": "meal_day",
   "label": "厨房执行日",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Meal Kitchen Day"
  },
  {
   "fieldname": "meal_date",
   "label": "供餐日期",
   "fieldtype": "Date",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "meal_type",
   "label": "陪餐餐次",
   "fieldtype": "Select",
   "reqd": 1,
   "in_list_view": 1,
   "options": "早餐\n早点\n午餐\n午点\n晚餐"
  },
  {
   "fieldname": "companion",
   "label": "陪餐人员",
   "fieldtype": "Link",
   "in_list_view": 1,
   "read_only": 1,
   "options": "User"
  },
  {
   "fieldname": "attended_at",
   "label": "实际陪餐时间",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "evaluation",
   "label": "陪餐评价",
   "fieldtype": "Select",
   "reqd": 1,
   "in_list_view": 1,
   "options": "满意\n需改进\n发现食品安全问题"
  },
  {
   "fieldname": "feedback",
   "label": "评价及师生意见",
   "fieldtype": "Small Text",
   "reqd": 1
  },
  {
   "fieldname": "photo",
   "label": "现场照片",
   "fieldtype": "Attach Image"
  },
  {
   "fieldname": "video",
   "label": "现场视频",
   "fieldtype": "Attach"
  },
  {
   "fieldname": "attested",
   "label": "本人确认以上记录",
   "fieldtype": "Check"
  },
  {
   "fieldname": "remarks",
   "label": "说明",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Meal Companion"
  }
 ]
}
