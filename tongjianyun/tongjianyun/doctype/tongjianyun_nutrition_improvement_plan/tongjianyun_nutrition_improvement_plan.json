{
 "doctype": "DocType",
 "name": "Tongjianyun Nutrition Improvement Plan",
 "module": "Tongjianyun",
 "editable_grid": 1,
 "fields": [
  {
   "fieldname": "plan_title",
   "label": "计划名称",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1,
   "bold": 1
  },
  {
   "fieldname": "company",
   "label": "学校",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "period_column",
   "label": "",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "start_date",
   "label": "开始日期",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "end_date",
   "label": "结束日期",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "scope_section",
   "label": "适用范围",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "student_scope",
   "label": "适用学生",
   "fieldtype": "Select",
   "options": "全校在册学生\n指定班级",
   "reqd": 1,
   "default": "指定班级"
  },
  {
   "fieldname": "batches",
   "label": "指定班级",
   "fieldtype": "Table",
   "options": "Tongjianyun Nutrition Plan Batch",
   "depends_on": "eval:doc.student_scope === '指定班级'"
  },
  {
   "fieldname": "ingredient_section",
   "label": "适用餐次与食材",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "ingredients",
   "label": "专项食材清单",
   "fieldtype": "Table",
   "options": "Tongjianyun Nutrition Plan Ingredient",
   "reqd": 1
  },
  {
   "fieldname": "notes",
   "label": "配置依据",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "options": "Tongjianyun Nutrition Improvement Plan",
   "no_copy": 1,
   "read_only": 1
  }
 ],
 "field_order": [
  "plan_title",
  "company",
  "period_column",
  "start_date",
  "end_date",
  "scope_section",
  "student_scope",
  "batches",
  "ingredient_section",
  "ingredients",
  "notes",
  "amended_from"
 ],
 "autoname": "format:NMIP-{#####}",
 "title_field": "plan_title",
 "search_fields": "plan_title,company",
 "is_submittable": 1,
 "track_changes": 1,
 "sort_field": "start_date",
 "sort_order": "DESC",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "Purchase Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  }
 ]
}
