  {
   "fieldname": "disposed_at",
   "label": "实际处置时间",
   "fieldtype": "Datetime",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "disposal_note",
   "label": "处置说明",
   "fieldtype": "Small Text",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "remarks",
   "label": "说明",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Food Sample"
  }
 ]
