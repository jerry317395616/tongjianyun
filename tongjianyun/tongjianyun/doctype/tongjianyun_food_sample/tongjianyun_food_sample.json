   "label": "厨房执行日",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Meal Kitchen Day"
  },
  {
   "fieldname": "meal_date",
   "label": "供餐日期",
   "fieldtype": "Date",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "meal_type",
   "label": "餐次",
   "fieldtype": "Select",
   "reqd": 1,
   "in_list_view": 1,
   "options": "早餐\n早点\n午餐\n午点\n晚餐"
  },
  {
   "fieldname": "dish",
   "label": "留样成品",
   "fieldtype": "Link",
   "reqd": 1,
   "in_list_view": 1,
   "options": "BOM"
  },
  {
   "fieldname": "weight",
   "label": "留样量（克）",
   "fieldtype": "Float",
   "reqd": 1,
