  {
   "fieldname": "dispose_after",
   "label": "保留至",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "storage_location",
   "label": "存放位置",
   "fieldtype": "Data",
   "reqd": 1
