   "role": "膳食园方负责人",
   "read": 1
  }
 ],
 "is_submittable": 1,
 "field_order": [
  "section_company",
  "company",
  "canteen",
  "external_handover",
  "column_meal_day",
  "meal_day",
  "meal_date",
  "meal_type",
  "section_dish",
  "dish",
  "external_dish",
  "weight",
  "column_sampled_at",
  "sampled_at",
  "dispose_after",
  "storage_location",
  "photo",
  "operator",
  "section_disposed_at",
  "disposed_at",
  "disposal_note",
  "remarks",
  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "company",
   "label": "园所 / 账套",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "canteen",
   "label": "食堂",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Tongjianyun Canteen"
  },
  {
   "fieldname": "meal_day",
   "label": "厨房执行日",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "options": "Meal Kitchen Day",
   "depends_on": "eval:!doc.external_handover",
   "mandatory_depends_on": "eval:!doc.external_handover"
  },
  {
   "fieldname": "meal_date",
   "label": "供餐日期",
   "fieldtype": "Date",
   "in_list_view": 1,
   "read_only": 1
  },
  {
   "fieldname": "meal_type",
   "label": "餐次",
   "fieldtype": "Select",
   "reqd": 1,
   "in_list_view": 1,
   "options": "早餐\n早点\n午餐\n午点\n晚餐"
  },
  {
   "fieldname": "dish",
   "label": "留样成品",
   "fieldtype": "Link",
   "in_list_view": 1,
   "options": "BOM",
   "depends_on": "eval:!doc.external_handover",
   "mandatory_depends_on": "eval:!doc.external_handover"
  },
  {
   "fieldname": "weight",
   "label": "留样量（克）",
   "fieldtype": "Float",
   "reqd": 1,
   "non_negative": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "sampled_at",
   "label": "留样时间",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "dispose_after",
   "label": "保留至",
   "fieldtype": "Datetime",
   "read_only": 1
  },
  {
   "fieldname": "storage_location",
   "label": "存放位置",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "photo",
   "label": "留样照片",
   "fieldtype": "Attach Image"
  },
  {
   "fieldname": "operator",
   "label": "留样人",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "User"
  },
  {
   "fieldname": "disposed_at",
   "label": "实际处置时间",
   "fieldtype": "Datetime",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "disposal_note",
   "label": "处置说明",
   "fieldtype": "Small Text",
   "read_only": 1,
   "no_copy": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "remarks",
   "label": "说明",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Food Sample"
  },
  {
   "fieldname": "external_handover",
   "label": "园外供餐交接",
   "fieldtype": "Link",
   "options": "Tongjianyun Meal Delivery Handover",
   "depends_on": "eval:!doc.meal_day"
  },
  {
   "fieldname": "external_dish",
   "label": "交接成品名称",
   "fieldtype": "Data",
   "depends_on": "eval:doc.external_handover",
   "mandatory_depends_on": "eval:doc.external_handover"
  },
  {
   "fieldname": "section_company",
   "fieldtype": "Section Break",
   "label": "供餐来源"
  },
  {
   "fieldname": "column_meal_day",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "section_dish",
   "fieldtype": "Section Break",
   "label": "成品留样"
  },
  {
   "fieldname": "column_sampled_at",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "section_disposed_at",
   "fieldtype": "Section Break",
   "label": "留样处置"
  }
 ]
}
