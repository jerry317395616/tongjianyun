  "amended_from"
 ],
 "fields": [
  {
   "fieldname": "company",
   "label": "园所 / 账套",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Company"
  },
  {
   "fieldname": "canteen",
   "label": "食堂",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Tongjianyun Canteen",
   "in_list_view": 1
  },
  {
   "fieldname": "supplier",
   "label": "供应商",
   "fieldtype": "Link",
   "reqd": 1,
   "in_standard_filter": 1,
   "options": "Supplier",
   "in_list_view": 1
  },
  {
   "fieldname": "purchase_order",
   "label": "采购订单",
   "fieldtype": "Link",
   "reqd": 1,
   "options": "Purchase Order"
  },
  {
   "fieldname": "expected_on",
   "label": "预计到货日",
   "fieldtype": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "package_reference",
   "label": "随货单号",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "qr_token",
   "label": "随货二维码令牌",
   "fieldtype": "Data",
   "read_only": 1,
   "hidden": 1,
   "no_copy": 1,
   "unique": 1
  },
  {
   "fieldname": "progress",
   "label": "配送状态",
   "fieldtype": "Select",
   "in_list_view": 1,
   "read_only": 1,
   "options": "待接单\n已接单\n备货\n分拣\n配送\n到货\n拒接",
   "default": "待接单",
   "allow_on_submit": 1
  },
  {
   "fieldname": "progress_at",
   "label": "状态更新时间",
   "fieldtype": "Datetime",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "progress_note",
   "label": "缺货、延迟或拒接说明",
   "fieldtype": "Small Text",
   "read_only": 1,
   "allow_on_submit": 1
  },
  {
   "fieldname": "items",
   "label": "配送批次明细",
   "fieldtype": "Table",
   "options": "Tongjianyun Canteen Delivery Item",
   "description": "发货前按实际配送填写数量、供应商批号、生产日期和有效期。"
  },
  {
   "fieldname": "evidence",
   "label": "随货票证及检验报告",
   "fieldtype": "Table",
   "options": "Tongjianyun Canteen Delivery Evidence",
   "allow_on_submit": 1,
   "description": "按食堂的验收要求登记票证号，并附上本批次对应的凭证。"
  },
  {
   "fieldname": "remarks",
   "label": "配送备注",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Canteen Delivery"
  },
  {
   "fieldname": "section_company",
   "fieldtype": "Section Break",
   "label": "配送信息"
  },
  {
   "fieldname": "column_expected_on",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "section_items",
   "fieldtype": "Section Break",
   "label": "本批食材"
  },
  {
   "fieldname": "manifest_tab",
   "fieldtype": "Tab Break",
   "label": "配送明细"
  },
  {
   "fieldname": "evidence_tab",
   "fieldtype": "Tab Break",
   "label": "随货票证"
  },
  {
   "fieldname": "evidence_section",
   "fieldtype": "Section Break",
   "label": "票证与检验报告"
  },
  {
   "fieldname": "details_tab",
   "fieldtype": "Tab Break",
   "label": "批次信息"
  }
 ]
}
