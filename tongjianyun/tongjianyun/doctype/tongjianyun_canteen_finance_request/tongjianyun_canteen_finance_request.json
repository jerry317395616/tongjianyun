  {
   "role": "Accounts Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1,
   "submit": 1,
   "cancel": 1,
   "amend": 1
  },
  {
   "role": "膳食财政监管",
