  {
   "fieldname": "remarks",
   "label": "说明",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "amended_from",
   "label": "修订自",
   "fieldtype": "Link",
   "read_only": 1,
   "no_copy": 1,
   "options": "Tongjianyun Canteen Finance Request"
  }
 ]
